---
import Base from '../../layouts/Base.astro';
import '../../styles/blog.css';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('blog', ({ data }) => !data.brouillon);
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const { title, description, date, updated, categorie } = article.data;
const fmt = (d: Date) => d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
const url = new URL(`/blog/${article.id}`, Astro.site).href;
const words = (article.body ?? '').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 220));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  inLanguage: 'fr-FR',
  mainEntityOfPage: url,
  author: { '@type': 'Person', name: 'Alexia Delépine', url: 'https://ppcalexia.com' },
  publisher: { '@type': 'Organization', name: 'PPC Alexia', url: 'https://ppcalexia.com' },
};
---
<Base title={`${title} | PPC Alexia`} description={description} type="article" schema={schema}>
  <meta slot="head" property="article:published_time" content={date.toISOString()} />
  <main>
    <section class="b-hero">
      <div class="b-wrap b-narrow">
        <nav class="b-crumbs"><a href="/">Accueil</a> / <a href="/blog">Blog</a></nav>
        {categorie && <p class="b-label">// {categorie}</p>}
        <h1>{title}</h1>
        <p class="b-lead">{description}</p>
        <div class="b-meta">
          <span>Alexia Delépine</span>
          <time datetime={date.toISOString()}>{fmt(date)}</time>
          <span>{minutes} min de lecture</span>
        </div>
      </div>
    </section>
    <section class="b-body">
      <div class="b-wrap b-narrow">
        <article class="b-prose">
          <Content />
        </article>
        <aside class="b-cta">
          <h2>Vous voulez que je regarde votre compte ?</h2>
          <p>Audit Google Ads offert : 15 minutes, sans engagement, avec des quick wins concrets.</p>
          <a class="b-btn" target="_blank" rel="noopener noreferrer" href="https://calendly.com/alexia-delepine/rencontrer-un-consultant-make-sense-a">Réserver mon audit →</a>
        </aside>
        <a class="b-back" href="/blog">← Tous les articles</a>
      </div>
    </section>
  </main>
</Base>
