---
import headerHtml from '../fragments/header.html?raw';
import footerHtml from '../fragments/footer.html?raw';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  schema?: Record<string, unknown>;
}

const { title, description, type = 'website', schema } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site).href;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'PPC Alexia',
  description: 'Consultante Google Ads & Facebook Ads spécialisée e-commerce',
  url: 'https://ppcalexia.com',
  address: { '@type': 'PostalAddress', addressLocality: 'Lille', addressCountry: 'FR' },
  priceRange: '€€',
  sameAs: ['https://www.linkedin.com/in/alexia-delepine/', 'https://www.youtube.com/@ppcalexia'],
};
---
<!doctype html>
<html lang="fr" class="inter_8e2e04e4-module__oHaD3q__variable jetbrains_mono_8e1b1c2a-module__OyRuAW__variable">
<head>
  <!-- Google Tag Manager -->
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-MBGVZCC8');</script>
  <!-- End Google Tag Manager -->
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Alexia Delépine" />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="PPC Alexia" />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:type" content={type} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <link rel="icon" href="/icon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-icon.png" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="preload" href="/_site/media/051742360c26797e-s.p.0f97p8c3305p~.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/_site/media/83afe278b6a6bb3c-s.p.0q-301v4kxxnr.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/_site/css/fonts.css" />
  <link rel="stylesheet" href="/_site/css/site.css" />
  <link rel="stylesheet" href="/_site/css/fixes.css" />
  <link rel="stylesheet" href="/_site/css/newsletter.css" />
  <slot name="head" />
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
</head>
<body class="font-sans antialiased">
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MBGVZCC8" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <Fragment set:html={headerHtml} />
  <slot />
  <Fragment set:html={footerHtml} />

  <script is:inline>
    (function () {
      // Menu mobile
      var btn = document.querySelector('button[aria-label="Toggle menu"]');
      var panel = btn && btn.closest('header').querySelector('div.md\\:hidden.fixed');
      if (btn && panel) {
        // sortir le panneau du header (son flou d'arrière-plan le rognait)
        document.body.appendChild(panel);
        panel.style.zIndex = '49';
        var bars = btn.querySelectorAll('span');
        function setOpen(open) {
          panel.classList.toggle('opacity-0', !open);
          panel.classList.toggle('invisible', !open);
          panel.classList.toggle('opacity-100', open);
          panel.classList.toggle('visible', open);
          document.body.style.overflow = open ? 'hidden' : '';
          if (bars.length === 3) {
            bars[0].style.transform = open ? 'translateY(8px) rotate(45deg)' : '';
            bars[1].style.opacity = open ? '0' : '';
            bars[2].style.transform = open ? 'translateY(-8px) rotate(-45deg)' : '';
          }
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        }
        btn.addEventListener('click', function () { setOpen(panel.classList.contains('invisible')); });
        panel.querySelectorAll('a').forEach(function (a) { a.addEventListener('click', function () { setOpen(false); }); });
      }
      // Bouton "Réserver" collant en bas sur mobile
      var sticky = document.querySelector('div.fixed.bottom-0.translate-y-full');
      if (sticky) {
        var onScroll = function () {
          var show = window.scrollY > 600;
          sticky.classList.toggle('translate-y-full', !show);
          sticky.classList.toggle('translate-y-0', show);
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }
    })();
  </script>
  <!-- Pop-up newsletter -->
  <div class="nl-pop" id="nl-pop" role="dialog" aria-modal="true" aria-labelledby="nl-pop-title" aria-hidden="true">
    <div class="nl-card">
      <button type="button" class="nl-close" data-nl-close aria-label="Fermer">&times;</button>
      <p class="nl-label">// Newsletter</p>
      <h2 class="nl-title" id="nl-pop-title">Recevez mes stratégies Google Ads &amp; Meta Ads.</h2>
      <p class="nl-text">Ce que je teste et ce qui fonctionne sur les comptes e-commerce que je gère, directement dans votre boîte mail.</p>
      <div class="nl-embed"><iframe data-src="https://ppcalexia.substack.com/embed" title="Inscription à la newsletter PPC Alexia" frameborder="0" scrolling="no"></iframe></div>
      <button type="button" class="nl-later" data-nl-close>Non merci</button>
    </div>
  </div>
  <script is:inline>
    (function () {
      var pop = document.getElementById('nl-pop');
      if (!pop) return;
      // Une fois par visite (session du navigateur).
      // Seule exception : la personne a cliqué dans le formulaire (probablement inscrite).
      var SESSION_KEY = 'ppca_nl_seen';
      var KEY = 'ppca_nl_until';
      var DAY = 864e5;
      function get() { try { return +localStorage.getItem(KEY) || 0; } catch (e) { return 0; } }
      function snooze(days) { try { localStorage.setItem(KEY, String(Date.now() + days * DAY)); } catch (e) {} }
      function seen() { try { return sessionStorage.getItem(SESSION_KEY) === '1'; } catch (e) { return false; } }
      function markSeen() { try { sessionStorage.setItem(SESSION_KEY, '1'); } catch (e) {} }
      function track(name) { window.dataLayer = window.dataLayer || []; window.dataLayer.push({ event: name }); }
      if (get() > Date.now() || seen()) return;

      var iframe = pop.querySelector('iframe');
      var shown = false, lastFocus = null;
      var sticky = document.querySelector('div.fixed.bottom-0.z-40');

      function open() {
        if (shown || document.body.style.overflow === 'hidden') return;
        shown = true;
        window.removeEventListener('scroll', onScroll);
        clearTimeout(timer);
        if (!iframe.src) iframe.src = iframe.getAttribute('data-src');
        lastFocus = document.activeElement;
        pop.classList.add('is-open');
        pop.setAttribute('aria-hidden', 'false');
        if (sticky) sticky.style.visibility = 'hidden';
        pop.querySelector('.nl-close').focus();
        markSeen(); // pas de nouvel affichage pendant cette visite
        track('newsletter_popup_view');
      }
      function close() {
        pop.classList.remove('is-open');
        pop.setAttribute('aria-hidden', 'true');
        if (sticky) sticky.style.visibility = '';
        if (lastFocus && lastFocus.focus) lastFocus.focus();
        track('newsletter_popup_close');
      }
      pop.querySelectorAll('[data-nl-close]').forEach(function (b) { b.addEventListener('click', close); });
      pop.addEventListener('click', function (e) { if (e.target === pop) close(); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && pop.classList.contains('is-open')) close(); });

      // Clic dans le formulaire Substack : on considère la personne comme intéressée
      window.addEventListener('blur', function () {
        if (pop.classList.contains('is-open') && document.activeElement === iframe) {
          snooze(180);
          track('newsletter_popup_engage');
        }
      });

      // Déclenchement : 5 secondes sur la page, ou 15 % de la page lue,
      // ou (sur ordinateur) quand la souris quitte la fenêtre vers le haut
      function onScroll() {
        var h = document.documentElement.scrollHeight - window.innerHeight;
        if (h > 0 && window.scrollY / h > 0.15) open();
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      document.addEventListener('mouseout', function (e) {
        if (!e.relatedTarget && e.clientY <= 0) open();
      });
      var timer = setTimeout(open, 5000);
    })();
  </script>
</body>
</html>
